[Unit]
Description=TLS proxy for LXA IOBus Server
Wants=tac-tls-gen-selfsigned.service
After=tac-tls-gen-selfsigned.service
RequiresMountsFor=/srv/tacd

[Service]
ExecStart=/usr/bin/socat \
    OPENSSL-LISTEN:8443,pf=ip6,ipv6only=0,cert=/srv/tacd/server.cert.pem,key=/srv/tacd/server.key.pem,reuseaddr,fork,su=nobody,verify=0 \
    TCP4:localhost:8080
Restart=on-failure

# Hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
NoNewPrivileges=yes
# only what socat needs before/after su=nobody
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=
RestrictFileSystems=
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
