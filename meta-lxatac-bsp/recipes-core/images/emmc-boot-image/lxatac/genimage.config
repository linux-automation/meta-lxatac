image @IMAGE@img {
    hdimage {
        partition-table-type = none
    }

    partition fsbl {
        image = "trusted-firmware-a/tf-a-stm32mp157c-lxa-tac.stm32"
        size = 256K
    }

    partition fip {
        image = "@IMAGE@fip"
        offset = 256K
    }
}

image @IMAGE@fip {
    fip {
        fw-config = "trusted-firmware-a/stm32mp157c-lxa-tac-fw-config.dtb"
        hw-config = "trusted-firmware-a/stm32mp157c-lxa-tac-fw-config.dtb"
        nt-fw = "barebox-stm32mp15xc-lxa-tac.img"
        tos-fw = { "trusted-firmware-a/bl32.bin" }
        tos-fw-config = "trusted-firmware-a/stm32mp157c-lxa-tac-bl32.dtb"
    }

    size = 1M
}
